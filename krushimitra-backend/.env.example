# Copy to .env and fill in. NEVER commit .env.

ENV=dev
APP_NAME=KrushiMitra AI Backend

# Database (matches docker-compose). pgvector extension required.
DATABASE_URL=postgresql+psycopg://krushi:krushi@localhost:5432/krushimitra

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256

# Object storage (local disk by default; set these for S3/MinIO later)
S3_BUCKET=krushimitra-images
S3_REGION=ap-south-1
# S3_ENDPOINT_URL=http://localhost:9000

# --- AI / external providers. Leave blank to use mocks. ---
# To turn the REAL Claude copilot on: set ANTHROPIC_API_KEY below AND USE_MOCKS=false.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5     # optional; switch to claude-haiku-5-5 for lower cost/latency
# BHASHINI_API_KEY=

# --- Weather (module 4) -----------------------------------------------------------------
# A FREE OpenWeatherMap key is enough: we use /data/2.5/weather + /data/2.5/forecast, NOT the
# paid One Call 3.0. Get one at https://openweathermap.org/api (new keys take ~1-2 h to activate).
#
# Opt-in is by presence, like vision: set the key and forecasts go live, independent of USE_MOCKS.
# The crop advisories ("don't spray today, it will wash off") are built in Python either way, so
# they work on sample weather too — the response's `source` says which it was and the app badges
# anything starting with "mock" as नमुना माहिती.
#
# Key stays SERVER-SIDE. The app calls this backend, never OpenWeatherMap directly.
# OPENWEATHER_API_KEY=
# WEATHER_PROVIDER=auto               # auto | mock | openweather  (mock forces sample data)
# WEATHER_TIMEOUT_S=12

# --- Mandi prices (module 6) ------------------------------------------------------------
# FREE key from https://data.gov.in/user/register. Resource 9ef84268-d588-465a-a308-a864a43d0070
# ("Current Daily Price of Various Commodities from Various Markets" / Agmarknet).
#
# Two things to know about that API:
#   * It serves only the CURRENT day — there is no history endpoint and no way to backfill. So
#     every board we fetch is appended to MARKET_HISTORY_DIR, and price trends come from what we
#     have accumulated. A fresh install honestly reports "trend unknown".
#   * Its filter parameter spelling is not documented consistently (filters[state] vs
#     filters[state.keyword] vs filters[State]), so the adapter tries each form and keeps the one
#     that returns rows. Check the log line "[market] agmarknet matched filter style ..." on the
#     first live call.
#
# Key stays SERVER-SIDE. The app calls this backend, never data.gov.in directly.
# DATAGOV_API_KEY=
# MARKET_PROVIDER=auto                # auto | mock | agmarknet  (mock forces sample data)
# MARKET_TIMEOUT_S=15
# MARKET_HISTORY_DIR=data/market
# TRANSPORT_RATE_PER_QTL_KM=0.6       # Rs/quintal/km, for net realisation; farmer-overridable

# --- Vision: the real crop-disease analysis (module 1) ---------------------------------
# Point this at a SELF-HOSTED OpenAI-compatible multimodal model and image analysis goes live.
# Works with vLLM / SGLang / Ollama / TGI, so Gemma 3, Qwen2.5-VL, InternVL or Gemma 4 all fit.
#
#   IMPORTANT: only Gemma 3 at 4B / 12B / 27B is multimodal. Gemma 3 *1B is text-only* and
#   cannot diagnose an image at all — a 1B deployment will reject or ignore the photo.
#
# Unlike the Claude key, this does NOT need USE_MOCKS=false: setting VISION_BASE_URL is the
# opt-in. Check GET /health -> "vision_provider" to confirm which engine is actually serving.
# VISION_BASE_URL=http://10.0.0.5:8000/v1
# VISION_API_KEY=
# VISION_MODEL=gemma-3-27b-it
# VISION_TIMEOUT_S=90
# VISION_JSON_MODE=true          # false for servers that reject response_format (some Ollama builds)
# VISION_PROVIDER=auto           # auto | mock | self_hosted | claude  (mock = force sample data)

# Below this confidence the API ABSTAINS: it returns identified=false with no treatment and no
# severity instead of naming a disease it isn't sure about. Raise it to be more cautious.
# VISION_MIN_CONFIDENCE=0.55

# Keep every diagnosed photo + prediction + farmer correction. This is the training dataset —
# a photo not saved on day one is a training example lost forever. See docs/DATASET.md.
# CAPTURE_ENABLED=true
# CAPTURE_DIR=data/captures

# Master switch. true = mock services everywhere (zero keys). Set false to use real providers
# (each still needs its key; a provider with no key falls back to mock automatically).
# Note: VISION_BASE_URL is independent of this — see above.
USE_MOCKS=true

# --- Self-hosted TEXT model for the Marathi chatbot (module 2) ---------------------------
# OpenAI-compatible endpoint: vLLM, SGLang, Ollama (/v1), TGI, LM Studio.
#
#   THIS IS NOT THE VISION ENDPOINT. A text-only model (Gemma 3 1B, Llama 3 8B, Qwen 2.5 7B)
#   can serve the chatbot and CANNOT analyse a crop photo. Image analysis needs a multimodal
#   model and VISION_BASE_URL below — Gemma 3 at 4B/12B/27B, Qwen2.5-VL, InternVL.
#
# Small models write weak Marathi. The prompt makes the model reason in English and answer in the
# farmer's language, which helps, but probe it with real questions before trusting it.
# Opt-in by presence; takes priority over ANTHROPIC_API_KEY because it is free.
# LLM_BASE_URL=http://10.0.0.5:11434/v1
# LLM_API_KEY=
# LLM_MODEL=gemma-3-1b-it
# LLM_TIMEOUT_S=60
# LLM_MAX_TOKENS=700
