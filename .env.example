# ──────────────────────────────────────────────────────────────────────────
# Krushimitra AI — environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#
# In Expo, only variables prefixed with EXPO_PUBLIC_ are readable in the app.
# Anything WITHOUT that prefix is treated as a server-only secret.
# ──────────────────────────────────────────────────────────────────────────

# ── FastAPI backend ──
# Usually leave BLANK in dev: the app auto-targets http://<metro-host>:8000 (same machine as Metro).
# Set this only to point at a non-default host or a deployed backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000

# ── Supabase (backend / storage / future auth) ──
# Safe to expose: the anon key is designed for client use with row-level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Weather: OpenWeatherMap (Step 4) ──
# Free-tier key. OK in the app for the MVP; proxy via Supabase later if abused.
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# ── Mandi prices: data.gov.in / Agmarknet (Step 6) ──
EXPO_PUBLIC_DATA_GOV_IN_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — do NOT put these in this app .env (EXPO_PUBLIC_ or not).
# A mobile app's code can be extracted, so these keys would be stolen.
# They live in the FastAPI backend instead: set them in  krushimitra-backend/.env
# (see krushimitra-backend/.env.example). Listed here only as a pointer.
# ──────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=   # Claude (chatbot + photo diagnosis) — set in krushimitra-backend/.env
# BHASHINI_API_KEY=    # AI4Bharat/Bhashini speech-to-text   — set in krushimitra-backend/.env
